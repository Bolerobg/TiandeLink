generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Plan {
  FREE
  STARTER
  PRO
  PREMIUM
}

enum LinkType {
  URL
  FEATURED
  PRODUCT
  BOOKING
  EMAIL_CAPTURE
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String?
  passwordHash String?
  plan         Plan      @default(FREE)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  profiles     Profile[]
  sessions     Session[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Profile {
  id              String   @id @default(cuid())
  ownerId         String
  username        String   @unique
  customDomain    String?  @unique
  displayName     String
  bio             String?
  avatarUrl       String?
  backgroundVideo String?
  password        String?
  donationUrl     String?
  timezone        String   @default("Europe/Sofia")
  socialInstagram String?
  socialFacebook  String?
  socialWhatsapp  String?
  socialViber     String?
  theme       Json     @default("{\"background\":\"#b7aa7e\",\"surface\":\"#c7b98b\",\"text\":\"#35231e\",\"accent\":\"#655b39\",\"buttonStyle\":\"solid\",\"cardRadius\":\"22px\",\"cardShadow\":\"3px 4px 0\",\"fontFamily\":\"Georgia, serif\",\"template\":\"classic\"}")
  footerBrand     Boolean  @default(true)
  isPublished     Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  links Link[]
  subscribers EmailSubscriber[]
}

model Link {
  id          String    @id @default(cuid())
  profileId   String
  title       String
  url         String
  type        LinkType  @default(URL)
  description String?
  imageUrl    String?
  icon        String?
  position    Int
  isActive    Boolean   @default(true)
  startsAt    DateTime?
  endsAt      DateTime?
  spotlight   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  clicks  ClickEvent[]
  subscribers EmailSubscriber[]

  @@index([profileId, position])
}

model ClickEvent {
  id        String   @id @default(cuid())
  linkId    String
  profileId String
  referrer  String?
  userAgent String?
  ipHash    String?
  country   String?
  createdAt DateTime @default(now())

  link Link @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@index([profileId, createdAt])
  @@index([linkId, createdAt])
}

model EmailSubscriber {
  id        String   @id @default(cuid())
  profileId String
  linkId    String
  email     String
  createdAt DateTime @default(now())

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  link    Link    @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([linkId])
  @@unique([linkId, email])
}
